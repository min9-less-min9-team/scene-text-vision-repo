# 팀원별 설정. 복사해서 채우세요:  cp .env.example .env   (.env는 git에 올라가지 않습니다)
# 사용법은 README "RunPod 원격 실험" 참고.

# --- 개인 키 (각자 발급) ---
STV_USER=                     # 본인 이름(영문). 결과 폴더·wandb 태그·pod 이름에 쓰임
RUNPOD_API_KEY=               # RunPod Console → Settings → API Keys
WANDB_API_KEY=                # https://wandb.ai/authorize
HF_TOKEN=                     # (선택) gated 모델·다운로드 속도 제한 회피
GITHUB_TOKEN=                 # private repo clone용 PAT (repo read 권한)

# --- RunPod S3 (Network Volume을 S3 API로 접근). Console → Settings → S3 API Keys ---
RUNPOD_S3_ACCESS_KEY=         # user_... 
RUNPOD_S3_SECRET_KEY=         # rps_...

# --- 팀 공용 (같은 volume을 공유하면 그대로, 각자 volume이면 본인 것으로) ---
RUNPOD_VOLUME_ID=             # Network Volume ID (= S3 bucket 이름)
RUNPOD_DATACENTER=EU-RO-1     # volume이 있는 데이터센터 (S3 API 지원: EUR-IS-1, EU-RO-1, EU-CZ-1, US-KS-2, US-CA-2 등)
WANDB_ENTITY=                 # wandb 팀 이름 (비우면 개인 계정)
WANDB_PROJECT=stv

# --- pod 사양 ---
RUNPOD_GPU="NVIDIA GeForce RTX 4090"   # 쉼표로 여러 개 = 우선순위 순 대체. 예: "NVIDIA A100 80GB PCIe,NVIDIA A100-SXM4-80GB"
RUNPOD_GPU_COUNT=1
RUNPOD_CLOUD=SECURE           # network volume은 SECURE에서만 사용 가능
RUNPOD_DISK_GB=40             # 컨테이너 디스크 (venv + 풀어 둔 데이터)
RUNPOD_IMAGE=runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04
STV_REPO=min9-less-min9-team/scene-text-vision-repo
STV_BRANCH=feat/baseline
